{
    "name": "php-io-extensions/avkit",
    "type": "php-ext",
    "description": "1:1 PHP bindings of AVFoundation, AVFAudio, AVKit, CoreMedia and CoreVideo, as classes and functions named after their native counterparts",
    "keywords": [
        "avfoundation",
        "avkit",
        "coremedia",
        "video",
        "macos",
        "php-ext"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Project Saturn Studios, LLC",
            "email": "info@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-appkit": "^0.11.2"
    },
    "require-dev": {
        "pestphp/pest": "^4.0"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.11.x-dev"
        }
    },
    "php-ext": {
        "extension-name": "avkit",
        "priority": 30,
        "support-zts": true,
        "support-nts": true,
        "os-families": [
            "darwin"
        ],
        "configure-options": [
            {
                "name": "enable-avkit",
                "description": "Enable the avkit extension",
                "needs-value": false
            }
        ]
    }
}
